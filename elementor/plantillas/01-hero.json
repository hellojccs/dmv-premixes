        {
          "id": "8f704b0",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "_title": "Franja de logos de clientes",
            "_element_width": "inherit",
            "html": "<style>\n.dmv-marquee{position:relative;width:100vw;margin:110px 0 0 calc(50% - 50vw);overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);}\n.dmv-marquee-track{display:flex;width:max-content;animation:dmv-marquee 32s linear infinite;}\n.dmv-marquee:hover .dmv-marquee-track{animation-play-state:paused;}\n.dmv-marquee-item{flex:none;width:250px;display:flex;align-items:center;justify-content:center;color:#F6F7F2;opacity:.82;transition:opacity .2s;}\n.dmv-marquee-item:hover{opacity:1;}\n.dmv-marquee-item svg{height:46px;width:auto;max-width:200px;}\n@keyframes dmv-marquee{to{transform:translateX(-50%);}}\n@media (prefers-reduced-motion:reduce){.dmv-marquee-track{animation:none;}}\n@media (max-width:767px){.dmv-marquee{margin-top:72px;}.dmv-marquee-item{width:200px;}.dmv-marquee-item svg{height:38px;}}\n</style>\n<!-- Logos de clientes: marcas de EJEMPLO. Reemplazar por los logos reales. -->\n<div class=\"dmv-marquee\" aria-label=\"Clientes\"><div class=\"dmv-marquee-track\">\n<div class=\"dmv-marquee-item\"><svg role=\"img\" aria-label=\"Agronorte\" viewBox=\"0 0 230 60\" fill=\"currentColor\">\n<g fill=\"currentColor\"><path d=\"M4 48 20 12l16 36h-7L20 28l-9 20z\"/><path d=\"M22 48 34 22l12 26z\" opacity=\".7\"/>\n<text x=\"56\" y=\"37\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-weight=\"900\" font-size=\"23\" letter-spacing=\"1\">AGRONORTE</text>\n<text x=\"57\" y=\"51\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-size=\"7.8\" letter-spacing=\"3.2\">INSUMOS PECUARIOS</text></g>\n</svg></div>\n<div class=\"dmv-marquee-item\"><svg role=\"img\" aria-label=\"Bebidas Cumbre\" viewBox=\"0 0 200 60\" fill=\"currentColor\">\n<path d=\"M20 6C14 16 7 25 7 35a13 13 0 0 0 26 0C33 25 26 16 20 6z\" fill=\"currentColor\"/>\n<path d=\"M14 36a6 6 0 0 0 6 6\" fill=\"none\" stroke=\"#195DE4\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n<g fill=\"currentColor\"><text x=\"44\" y=\"38\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-weight=\"800\" font-style=\"italic\" font-size=\"30\" letter-spacing=\"-1\">cumbre</text>\n<text x=\"46\" y=\"53\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-size=\"8.5\" letter-spacing=\"3.4\">BEBIDAS NATURALES</text></g>\n</svg></div>\n<div class=\"dmv-marquee-item\"><svg role=\"img\" aria-label=\"Galletas Aurora\" viewBox=\"0 0 200 60\" fill=\"currentColor\">\n<g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\"><path d=\"M6 44a16 16 0 0 1 32 0\"/><path d=\"M22 18v-8M9.5 23.5 4 18M34.5 23.5 40 18M2 44h40\"/></g>\n<g fill=\"currentColor\"><text x=\"52\" y=\"38\" font-family=\"Georgia, 'Times New Roman', serif\" font-size=\"29\" letter-spacing=\"0.5\">Aurora</text>\n<text x=\"53\" y=\"52\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-size=\"8\" letter-spacing=\"3.6\">GALLETAS · 1972</text></g>\n</svg></div>\n<div class=\"dmv-marquee-item\"><svg role=\"img\" aria-label=\"Granja Santa Elena\" viewBox=\"0 0 220 60\" fill=\"currentColor\">\n<g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linejoin=\"round\"><path d=\"M4 26 24 10l20 16v26H4z\"/><path d=\"M17 52V36h14v16M17 36l14 16M31 36 17 52\"/></g>\n<g fill=\"currentColor\"><text x=\"56\" y=\"27\" font-family=\"Georgia, 'Times New Roman', serif\" font-style=\"italic\" font-size=\"15\">Granja</text>\n<text x=\"55\" y=\"47\" font-family=\"Georgia, 'Times New Roman', serif\" font-weight=\"700\" font-size=\"18\" letter-spacing=\"1.8\">SANTA ELENA</text></g>\n</svg></div>\n<div class=\"dmv-marquee-item\"><svg role=\"img\" aria-label=\"Lacteos Sierra Azul\" viewBox=\"0 0 220 60\" fill=\"currentColor\">\n<g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><path d=\"M3 50 19 22l9 14 8-11 14 25z\"/><path d=\"m15 29 4 4 4-5\"/></g>\n<g fill=\"currentColor\"><text x=\"60\" y=\"22\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-size=\"9.5\" letter-spacing=\"4.5\">LÁCTEOS</text>\n<text x=\"58\" y=\"47\" font-family=\"Georgia, 'Times New Roman', serif\" font-style=\"italic\" font-size=\"26\">Sierra Azul</text></g>\n</svg></div>\n<div class=\"dmv-marquee-item\"><svg role=\"img\" aria-label=\"Molinos Altavista\" viewBox=\"0 0 230 60\" fill=\"currentColor\">\n<g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M20 56V12\"/></g>\n<g fill=\"currentColor\">\n<ellipse cx=\"13.5\" cy=\"22\" rx=\"4\" ry=\"7.5\" transform=\"rotate(-30 13.5 22)\"/><ellipse cx=\"26.5\" cy=\"22\" rx=\"4\" ry=\"7.5\" transform=\"rotate(30 26.5 22)\"/>\n<ellipse cx=\"13.5\" cy=\"34\" rx=\"4\" ry=\"7.5\" transform=\"rotate(-30 13.5 34)\"/><ellipse cx=\"26.5\" cy=\"34\" rx=\"4\" ry=\"7.5\" transform=\"rotate(30 26.5 34)\"/>\n<ellipse cx=\"13.5\" cy=\"46\" rx=\"4\" ry=\"7.5\" transform=\"rotate(-30 13.5 46)\"/><ellipse cx=\"26.5\" cy=\"46\" rx=\"4\" ry=\"7.5\" transform=\"rotate(30 26.5 46)\"/>\n<ellipse cx=\"20\" cy=\"10\" rx=\"3.6\" ry=\"7\"/>\n<text x=\"44\" y=\"31\" font-family=\"Georgia, 'Times New Roman', serif\" font-weight=\"700\" font-size=\"21\" letter-spacing=\"2.5\">MOLINOS</text>\n<text x=\"45\" y=\"49\" font-family=\"Georgia, 'Times New Roman', serif\" font-size=\"12.5\" letter-spacing=\"5.2\">ALTAVISTA</text></g>\n</svg></div>\n<div class=\"dmv-marquee-item\"><svg role=\"img\" aria-label=\"Nutrivet\" viewBox=\"0 0 210 60\" fill=\"currentColor\">\n<rect x=\"2\" y=\"8\" width=\"44\" height=\"44\" rx=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"/>\n<g fill=\"currentColor\"><circle cx=\"15\" cy=\"25\" r=\"3.6\"/><circle cx=\"21.5\" cy=\"18\" r=\"3.6\"/><circle cx=\"29.5\" cy=\"18\" r=\"3.6\"/><circle cx=\"35\" cy=\"25\" r=\"3.6\"/>\n<path d=\"M25 27c-5 0-9.5 6.5-9.5 11 0 3 2 4.6 4.6 4.6 2 0 3.2-1 4.9-1s2.9 1 4.9 1c2.6 0 4.6-1.6 4.6-4.6 0-4.5-4.5-11-9.5-11z\"/>\n<text x=\"58\" y=\"36\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-weight=\"800\" font-size=\"27\" letter-spacing=\"-0.8\">nutrivet</text>\n<text x=\"59\" y=\"51\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-size=\"8.5\" letter-spacing=\"2.6\">NUTRICIÓN ANIMAL</text></g>\n</svg></div>\n<div class=\"dmv-marquee-item\"><svg role=\"img\" aria-label=\"Panificadora Del Valle\" viewBox=\"0 0 230 60\" fill=\"currentColor\">\n<circle cx=\"28\" cy=\"30\" r=\"25\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/><circle cx=\"28\" cy=\"30\" r=\"20.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\"/>\n<g fill=\"currentColor\"><text x=\"28\" y=\"36\" text-anchor=\"middle\" font-family=\"Georgia, 'Times New Roman', serif\" font-weight=\"700\" font-size=\"16\" letter-spacing=\"0.5\">PdV</text>\n<text x=\"64\" y=\"29\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-weight=\"700\" font-size=\"15\" letter-spacing=\"1.6\">PANIFICADORA</text>\n<text x=\"65\" y=\"46\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-size=\"11\" letter-spacing=\"6\">DEL VALLE</text></g>\n</svg></div>\n<!-- copia para el desplazamiento continuo -->\n<div class=\"dmv-marquee-item\"><svg aria-hidden=\"true\" viewBox=\"0 0 230 60\" fill=\"currentColor\">\n<g fill=\"currentColor\"><path d=\"M4 48 20 12l16 36h-7L20 28l-9 20z\"/><path d=\"M22 48 34 22l12 26z\" opacity=\".7\"/>\n<text x=\"56\" y=\"37\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-weight=\"900\" font-size=\"23\" letter-spacing=\"1\">AGRONORTE</text>\n<text x=\"57\" y=\"51\" font-family=\"'Helvetica Neue', Arial, sans-serif\" font-size=\"7.8\" letter-spacing=\"3.2\">INSUMOS PECUARIOS</text></g>\n</svg></div>\n<div class=\"dmv-marquee-item\"><svg aria-hidden=\"true\" viewBox=\"0 0 200 60\" fill=\"currentColor\">\n<path d=\"M20 6C14 16 7 25 7 35a13 13 0 0 0 26 0C33 25 26 16 20 6z\" fill=\"currentColor\"/>\n<path d=\"M14 36a6 6 0 0 0 6 6\" fill=\"none\" stroke=\"#195DE4\" stroke-width=\"2